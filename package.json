{
  "name": "rs4-pro-fx3-rig-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "validate": "node scripts/validate-data.mjs && node scripts/test-planner.mjs",
    "test:planner": "node scripts/test-planner.mjs",
    "build": "npm run validate && tsc --noEmit && vite build --config vite.config.ts",
    "build:public": "node scripts/validate-data.mjs --public && node scripts/test-planner.mjs && tsc --noEmit && vite build --config vite.config.ts --mode public-demo && node scripts/check-public-build.mjs",
    "preview:public": "vite preview --config vite.config.ts --mode public-demo",
    "preview": "vite preview --config vite.config.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "clsx": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.1"
  }
}
